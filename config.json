{
  "log": { "level": "warn" },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-ws",
      "listen": "0.0.0.0",
      "listen_port": __PORT__,
      "users": [{ "uuid": "__UUID__" }],
      "multiplex": { "enabled": true, "padding": false },
      "transport": { "type": "ws", "path": "__WS_PATH__", "max_early_data": 2048, "early_data_header_name": "Sec-WebSocket-Protocol" }
    }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }]
}
